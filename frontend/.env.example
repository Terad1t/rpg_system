# Em desenvolvimento deixe vazio: o Vite faz proxy de /api, /ws e /static para o backend.
# Em produção, se a API estiver em outro domínio, informe a URL completa.
# VITE_API_URL=https://api.exemplo.com
# VITE_WS_URL=wss://api.exemplo.com

# Endereço do backend usado pelo proxy do `npm run dev`.
# VITE_DEV_BACKEND=http://127.0.0.1:8000
