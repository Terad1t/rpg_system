# Copie para `.env` e ajuste. O arquivo `.env` nunca deve ir para o git.

# Obrigatória. Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Banco de dados (padrão: SQLite em ./rpg_system.db)
# DATABASE_URL=sqlite:///./rpg_system.db

# Endereços do frontend autorizados a chamar a API (separados por vírgula)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Habilita POST /api/auth/initialize-master (crie o Master e depois remova esta linha).
# Alternativa sem expor rota: uv run python -m scripts.create_user --role master --login mestre
# MASTER_BOOTSTRAP_TOKEN=

# Opcionais
# ACCESS_TOKEN_EXPIRE_MINUTES=480
# MAX_UPLOAD_BYTES=2097152
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_WINDOW_SECONDS=300
